# Qualtrics API Credentials Configuration
# Copy this file to .env and fill in your actual credentials to run in Live Mode.
# If these variables are not provided or remain empty, the tool runs in simulated Dry-Run Mode.

# Your unique Qualtrics API token (generated from Account Settings > Qualtrics IDs)
QUALTRICS_API_TOKEN=IqXb1TfDGvo8lnO9AnPsVnDHowgRACjv0dGfVtiX

# Your Qualtrics Data Center prefix (e.g. ca1, fra1, co1, iad1)
QUALTRICS_DATACENTER=fra1

# The survey ID you want to sync data to (e.g. SV_123456789abc)
QUALTRICS_SURVEY_ID=SV_8AEVYmqsH5Gd6xU
